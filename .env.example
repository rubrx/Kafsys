# =============================================================================
# Kafsys — Environment Configuration
# Copy to .env and adjust values before running `docker compose up`.
# =============================================================================

# ---- Required ----------------------------------------------------------------
# HS256 signing key for JWTs. MUST be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48-at-least-32-bytes

# ---- Optional ----------------------------------------------------------------
# Grafana admin password (defaults to kafsys-grafana if unset)
GRAFANA_ADMIN_PASSWORD=kafsys-grafana

# Token TTLs (ms) — overridden by identity-service when set
# JWT_ACCESS_EXPIRY_MS=900000
# JWT_REFRESH_EXPIRY_MS=604800000
